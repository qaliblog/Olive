{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@olive/plugin",
  "version": "2.2.5",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "generate": "bun script/icon-name.ts"
  },
  "exports": {
    ".": "./src/promise/index.ts",
    "./effect": "./src/effect/index.ts",
    "./host": "./src/host.ts",
    "./runtime": "./src/runtime.ts",
    "./tui": "./src/tui/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#plugin-source": {
      "bun": "./src/source.bun.ts",
      "node": "./src/source.node.ts",
      "default": "./src/source.node.ts"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@olive/ai": "workspace:*",
    "@olive/client": "workspace:*",
    "@olive/protocol": "workspace:*",
    "@olive/schema": "workspace:*",
    "@olive/util": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@olive/theme": "workspace:*",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@olive/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@olive/theme": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/olive.git",
    "directory": "packages/plugin"
  }
}
